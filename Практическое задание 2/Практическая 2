// ============================================ Задача 1 =====================================

#include <iostream> // Подключаем библиотеку для ввода и вывода
using namespace std; // Используем стандартное пространство имён

int main() { // Главная функция программы
    int a = 4, b = 5; // Создаём две переменные со значениями 4 и 5

    a = a + b; // Складываем a и b, результат записываем в a
    b = a - b; // Вычитаем старое b из нового a, получаем старое a
    a = a - b; // Вычитаем новое b из a, получаем старое b

    cout << "a = " << a << ", b = " << b << endl; // Выводим значения переменных

    return 0; // Завершаем программу успешно
} // Закрываем главную функцию

// =============================================Задача 2 =====================================

#include <iostream> // Подключаем библиотеку для ввода и вывода
using namespace std; // Используем стандартное пространство имён

int main() { // Главная функция программы
    int n; // Создаём переменную для ввода числа
    cin >> n; // Считываем число с клавиатуры

    long long fact = 1; // Храним текущий факториал
    long long result = 1; // Храним произведение факториалов

    for (int i = 1; i <= n; i++) { // Запускаем цикл от 1 до n
        fact = fact * i; // Вычисляем следующий факториал
        result = result * fact; // Умножаем результат на текущий факториал
    } // Завершаем цикл

    cout << "F(" << n << ") = " << result << endl; // Выводим итоговый результат

    return 0; // Завершаем программу успешно
} // Закрываем главную функцию

